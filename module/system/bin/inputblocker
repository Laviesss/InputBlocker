#!/system/bin/sh
#########################################################################################
# InputBlocker CLI Tool - by Laviesss
# Block ghost taps and unwanted touch inputs
# Supports: Magisk, KernelSU, APatch, SuperSU
#########################################################################################

detect_module_path() {
    local paths="
        /data/adb/modules/inputblocker
        /data/ksu/modules/inputblocker
        /data/apatch/modules/inputblocker
        /su/su.d/inputblocker
    "
    
    for path in $paths; do
        if [ -d "$path" ]; then
            echo "$path"
            return 0
        fi
    done
    
    echo "/data/adb/modules/inputblocker"
}

MODULE_DIR="$(detect_module_path)"
CONFIG_DIR="$MODULE_DIR/config"
PRIMARY_CONFIG="$CONFIG_DIR/profiles/default.conf"
LEGACY_CONFIG="$CONFIG_DIR/blocked_regions.conf"

if [ -f "$PRIMARY_CONFIG" ]; then
    CONFIG_FILE="$PRIMARY_CONFIG"
elif [ -f "$LEGACY_CONFIG" ]; then
    CONFIG_FILE="$LEGACY_CONFIG"
else
    CONFIG_FILE="$PRIMARY_CONFIG"
fi

LOG_FILE="/sdcard/Download/inputblocker.log"

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE" 2>/dev/null
    log -p i -t InputBlocker "$1"
}

mkdir -p "$CONFIG_DIR/profiles"

show_help() {
    cat << 'EOF'
InputBlocker CLI - Block ghost taps on your device
Created by Laviesss

Supports: Magisk, KernelSU, APatch, SuperSU

Usage: inputblocker <command> [options]

Commands:
    status              Show current status and blocked regions
    enable              Enable touch blocking
    disable             Disable touch blocking
    list                List all blocked regions
    add <x1,y1,x2,y2>   Add a blocked region (normalized 0.0-1.0)
    remove <id>         Remove a blocked region by ID
    clear               Remove all regions
    reset-crash         Reset crash protection flag
    path                Show module path
    gui                 Launch companion app Quick Menu

Kill Switch:
    Press Vol Down x3, then Vol Up x3 (within 5 seconds)

Examples:
    inputblocker add 0.65,0.65,1.0,1.0
    inputblocker list
    inputblocker reset-crash

EOF
}

load_config() {
    ENABLED=1
    FORCE_SAFE=0
    
    if [ -f "$CONFIG_FILE" ]; then
        ENABLED=$(grep -i "^enabled=" "$CONFIG_FILE" 2>/dev/null | cut -d= -f2)
        FORCE_SAFE=$(grep -i "^force_safe_mode=" "$CONFIG_FILE" 2>/dev/null | cut -d= -f2)
        ENABLED=${ENABLED:-1}
        FORCE_SAFE=${FORCE_SAFE:-0}
    fi
}

save_config() {
    load_config
    
    TEMP_FILE=$(mktemp)
    
    {
        echo "# InputBlocker Configuration"
        echo "enabled=$ENABLED"
        echo "force_safe_mode=$FORCE_SAFE"
        echo ""
        if [ -f "$CONFIG_FILE" ]; then
            grep -v "^#" "$CONFIG_FILE" 2>/dev/null | grep -v "^enabled=" | grep -v "^force_safe_mode=" | grep -v "^$"
        fi
    } > "$TEMP_FILE"
    
    mv "$TEMP_FILE" "$CONFIG_FILE"
    chmod 644 "$CONFIG_FILE"
}

get_regions() {
    if [ -f "$CONFIG_FILE" ]; then
        grep -v "^#" "$CONFIG_FILE" 2>/dev/null | grep -v "^enabled=" | grep -v "^force_safe_mode=" | grep -v "^$"
    fi
}

show_status() {
    load_config
    
    echo "InputBlocker Status - by Laviesss"
    echo "==========================="
    echo "Module path: $MODULE_DIR"
    echo "Config file: $CONFIG_FILE"
    echo ""
    
    if [ "$FORCE_SAFE" -eq 1 ]; then
        echo "Status: DISABLED (Crash Protection Active)"
        echo "Run 'inputblocker reset-crash' to re-enable"
    elif [ "$ENABLED" -eq 1 ]; then
        echo "Status: ENABLED"
    else
        echo "Status: DISABLED"
    fi
    
    echo ""
    echo "Blocked Regions:"
    
    COUNT=0
    get_regions | while read -r line; do
        [ -z "$line" ] && continue
        COUNT=$((COUNT + 1))
        echo "  [$COUNT] $line"
    done
    
    # Calculate count for display
    TOTAL=$(get_regions | grep -c .)
    [ "$TOTAL" -eq 0 ] && echo "  No regions configured"
    
    echo ""
    echo "Total regions: $TOTAL"
}

add_region() {
    local coords="$1"
    
    [ -z "$coords" ] && { echo "Error: Provide x1,y1,x2,y2 or region string"; return 1; }
    
    init_config
    load_config
    
    # If standard 4 float coords (x1,y1,x2,y2), format as default region line (isExclude=0, type=0, x1,y1,x2,y2, minPressure=0.15, maxDuration=300)
    FIELD_COUNT=$(echo "$coords" | awk -F',' '{print NF}')
    if [ "$FIELD_COUNT" -eq 4 ]; then
        REGION_LINE="0,0,$coords,0.15,300"
    else
        REGION_LINE="$coords"
    fi
    
    echo "$REGION_LINE" >> "$CONFIG_FILE"
    echo "Added region: $REGION_LINE"
    log_msg "Added region: $REGION_LINE"
}

remove_region() {
    local target_id="$1"
    
    [ -z "$target_id" ] && { echo "Error: Specify region ID"; return 1; }
    
    load_config
    
    TEMP_FILE=$(mktemp)

    {
        echo "# InputBlocker Configuration"
        echo "enabled=$ENABLED"
        echo "force_safe_mode=$FORCE_SAFE"
        echo ""
    } > "$TEMP_FILE"

    COUNT=0
    FOUND=0
    
    get_regions | while read -r line; do
        [ -z "$line" ] && continue
        COUNT=$((COUNT + 1))
        if [ "$COUNT" -eq "$target_id" ]; then
            FOUND=1
            echo "Removed region [$target_id]: $line"
        else
            echo "$line" >> "$TEMP_FILE"
        fi
    done
    
    mv "$TEMP_FILE" "$CONFIG_FILE"
    chmod 644 "$CONFIG_FILE"
}

clear_regions() {
    load_config
    echo "# InputBlocker Configuration" > "$CONFIG_FILE"
    echo "enabled=$ENABLED" >> "$CONFIG_FILE"
    echo "force_safe_mode=$FORCE_SAFE" >> "$CONFIG_FILE"
    echo "Regions cleared"
    log_msg "Cleared all regions"
}

enable_blocking() {
    load_config
    ENABLED=1
    save_config
    echo "InputBlocker ENABLED"
    log_msg "Blocking enabled"
    am broadcast -a com.inputblocker.ENABLE --ez force_safe 0 >/dev/null 2>&1
}

disable_blocking() {
    load_config
    ENABLED=0
    save_config
    echo "InputBlocker DISABLED"
    log_msg "Blocking disabled"
    am broadcast -a com.inputblocker.DISABLE >/dev/null 2>&1
}

reset_crash() {
    load_config
    FORCE_SAFE=0
    save_config
    echo "Crash protection reset"
    echo "Run 'inputblocker enable' to re-enable blocking"
    log_msg "Crash protection reset"
}

init_config() {
    [ -f "$CONFIG_FILE" ] && return
    
    cat > "$CONFIG_FILE" << 'EOF'
# InputBlocker Configuration
enabled=1
force_safe_mode=0

# Format: isExclude,type,x1,y1,x2,y2,minPressure,maxDuration
EOF
    chmod 644 "$CONFIG_FILE"
    log_msg "Created config file at $CONFIG_FILE"
}

init_config

case "$1" in
    status|list) show_status ;;
    enable) enable_blocking ;;
    disable) disable_blocking ;;
    add) add_region "$2" ;;
    remove) remove_region "$2" ;;
    clear) clear_regions ;;
    reset-crash) reset_crash ;;
    path) echo "$MODULE_DIR" ;;
    gui|setup) am start -f 0x10000000 -a com.inputblocker.ACTION_QUICK_MENU -n com.inputblocker.app/.MainActivity >/dev/null 2>&1 ;;
    help|--help|-h|"") show_help ;;
    *) echo "Unknown command: $1"; show_help ;;
esac
